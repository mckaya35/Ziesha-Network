plotshape(FLAG_FILLS and ev_entry and s.dir > 0, title='Long filled', style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.new(color.aqua, 0))
plotshape(FLAG_FILLS and ev_entry and s.dir < 0, title='Short filled', style=shape.triangledown, location=location.abovebar, size=size.tiny, color=color.new(color.gray, 0))
plotshape(FLAG_FILLS and ev_tp, title='TP filled', style=shape.diamond, location=location.abovebar, size=size.tiny, color=colors('tp'))
plotshape(FLAG_FILLS and ev_close, title='Close/Stop filled', style=shape.xcross, location=location.abovebar, size=size.tiny, color=colors('sl'))
