// *************************************************************************************************************************************************************************************************************************************************************************
// Acrypto - Weigthed Strategy v1.4.8  ->  INDICATOR version
// Original: https://github.com/AlbertoCuadra/algo_trading_weighted_strategy
//
// License: © accry - This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License
//                    https://creativecommons.org/licenses/by-nc-sa/4.0/
//
// Notes on the conversion:
//  - strategy() / strategy.* are not available in indicators, so the position (entries, TPs, stop, P&L, equity) is simulated
//    with a small "broker emulator": market orders fill on the NEXT bar open (+slippage), limit orders (TP) fill intrabar.
//  - Entry/exit/TP/SL messages are sent with alert() -> create the alert with "Any alert() function call".
//  - Logic fixes vs. v1.4.8 are marked with "FIX:".
// *************************************************************************************************************************************************************************************************************************************************************************
//@version=5
indicator(title='Acrypto - Weighted Strategy v1.4.8 [Indicator]', shorttitle='Acrypto WS', overlay=true, precision=2, max_labels_count=500)
// *************************************************************************************************************************************************************************************************************************************************************************
// INPUTS
// *************************************************************************************************************************************************************************************************************************************************************************
// * Type trading
allow_longs = input.bool(true, 'Allow Longs', group='Trading type')
allow_shorts = input.bool(true, 'Allow Shorts', group='Trading type')
// * Datastamp
from_day = input.int(1, 'From Day', minval=1, maxval=31, group='DataStamp')
from_month = input.int(1, 'From Month', minval=1, maxval=12, group='DataStamp')
from_year = input.int(2021, 'From Year', minval=1980, maxval=9999, group='DataStamp')
to_day = input.int(1, 'To Day', minval=1, maxval=31, group='DataStamp')
to_month = input.int(1, 'To Month', minval=1, maxval=12, group='DataStamp')
to_year = input.int(9999, 'To Year', minval=2017, maxval=9999, group='DataStamp')
// * Stop loss
stoploss = input.bool(true, 'Stop loss', group='Stop loss')
movestoploss = input.string('TP-2', 'Move stop loss', options=['None', 'Percentage', 'TP-1', 'TP-2', 'TP-3'], group='Stop loss')
movestoploss_entry = input.bool(false, 'Move stop loss to entry', group='Stop loss')
stoploss_perc = input.float(6.0, 'Stop Loss %', minval=0, maxval=100, group='Stop loss') * 0.01
move_stoploss_factor = input.float(20.0, 'Move stop loss factor %', group='Stop loss') * 0.01 + 1
stop_source = input.source(hl2, 'Stop Source', group='Stop loss')
// * Take profits
take_profits = input.bool(true, 'Take profits', group='Take Profits')
MAX_TP = input.int(6, 'Max number of TP', minval=1, maxval=6, group='Take Profits')
long_profit_perc = input.float(6.8, 'Long - take profits each x (%)', minval=0.0, maxval=999, step=1, group='Take Profits') * 0.01
long_profit_qty = input.float(15, 'Long - take x (%) from open position', minval=0.0, maxval=100, step=1, group='Take Profits')
short_profit_perc = input.float(13, 'Short - take profits each x (%)', minval=0.0, maxval=999, step=1, group='Take Profits') * 0.01
short_profit_qty = input.float(10, 'Short - take x (%) from open position', minval=0.0, maxval=100, step=1, group='Take Profits')
// * Delays
delay_macd = input.int(1, 'Candles delay MACD', minval=1, group='Delays')
delay_srsi = input.int(2, 'Candles delay Stoch RSI', minval=1, group='Delays')
delay_rsi = input.int(2, 'Candles delay RSI', minval=1, group='Delays')
delay_super = input.int(1, 'Candles delay Supertrend', minval=1, group='Delays')
delay_cross = input.int(1, 'Candles delay MA cross', minval=1, group='Delays')
delay_exit = input.int(7, 'Candles delay exit', minval=1, group='Delays')
// * Inputs Weigthed strategies
str_0 = input.bool(true, 'Strategy 0: Weighted Strategy', group='Weights')
weight_trigger = input.int(2, 'Weight Signal entry [0, 5]', minval=0, maxval=5, step=1, group='Weights')
weight_str1 = input.int(1, 'Weight Strategy 1 [0, 5]', minval=0, maxval=5, step=1, group='Weights')
weight_str2 = input.int(1, 'Weight Strategy 2 [0, 5]', minval=0, maxval=5, step=1, group='Weights')
weight_str3 = input.int(1, 'Weight Strategy 3 [0, 5]', minval=0, maxval=5, step=1, group='Weights')
weight_str4 = input.int(1, 'Weight Strategy 4 [0, 5]', minval=0, maxval=5, step=1, group='Weights')
weight_str5 = input.int(1, 'Weight Strategy 5 [0, 5]', minval=0, maxval=5, step=1, group='Weights')
// * Inputs strategy 1: MACD
str_1 = input.bool(true, 'Strategy 1: MACD', group='Strategy 1: MACD')
MA1_period_1 = input.int(16, 'MA 1', minval=1, maxval=9999, step=1, group='Strategy 1: MACD')
MA1_type_1 = input.string('EMA', 'MA1 Type', options=['RMA', 'SMA', 'EMA', 'WMA', 'HMA', 'DEMA', 'TEMA', 'VWMA'], group='Strategy 1: MACD')
MA1_source_1 = input.source(hl2, 'MA1 Source', group='Strategy 1: MACD')
MA2_period_1 = input.int(36, 'MA 2', minval=1, maxval=9999, step=1, group='Strategy 1: MACD')
MA2_type_1 = input.string('EMA', 'MA2 Type', options=['RMA', 'SMA', 'EMA', 'WMA', 'HMA', 'DEMA', 'TEMA', 'VWMA'], group='Strategy 1: MACD')
MA2_source_1 = input.source(high, 'MA2 Source', group='Strategy 1: MACD')
// * Inputs strategy 2: Stoch RSI oversold/overbought
str_2 = input.bool(true, 'Strategy 2: Stoch RSI', group='Strategy 2: Stoch RSI')
long_RSI = input.float(70, 'Exit SRSI Long (%)', minval=0.0, step=1, group='Strategy 2: Stoch RSI')
short_RSI = input.float(27, 'Exit SRSI Short (%)', minval=0.0, step=1, group='Strategy 2: Stoch RSI')
length_RSI = input.int(14, 'RSI Length', group='Strategy 2: Stoch RSI')
length_stoch = input.int(14, 'RSI Stochastic', group='Strategy 2: Stoch RSI')
smoothK = input.int(3, 'Smooth k', group='Strategy 2: Stoch RSI')
// * Inputs strategy 3: RSI oversold/overbought
str_3 = input.bool(true, 'Strategy 3: RSI', group='Strategy 3: RSI')
long_RSI2 = input.float(77, 'Exit RSI Long (%)', minval=0.0, step=1, group='Strategy 3: RSI')
short_RSI2 = input.float(30, 'Exit RSI Short (%)', minval=0.0, step=1, group='Strategy 3: RSI')
// * Inputs strategy 4: Supertrend
str_4 = input.bool(true, 'Strategy 4: Supertrend', group='Strategy 4: Supertrend')
periods_4 = input.int(2, 'ATR Period', group='Strategy 4: Supertrend')
source_4 = input.source(hl2, 'Source', group='Strategy 4: Supertrend')
multiplier = input.float(2.4, 'ATR Multiplier', step=0.1, group='Strategy 4: Supertrend')
change_ATR = input.bool(true, 'Change ATR Calculation Method ?', group='Strategy 4: Supertrend')
// * Inputs strategy 5: MA CROSS
str_5 = input.bool(true, 'Strategy 5: MA CROSS', group='Strategy 5: MA CROSS')
MA1_period_5 = input.int(46, 'MA 1', minval=1, maxval=9999, step=1, group='Strategy 5: MA CROSS')
MA1_type_5 = input.string('EMA', 'MA1 Type', options=['RMA', 'SMA', 'EMA', 'WMA', 'HMA', 'DEMA', 'TEMA', 'VWMA'], group='Strategy 5: MA CROSS')
MA1_source_5 = input.source(close, 'MA1 Source', group='Strategy 5: MA CROSS')
MA2_period_5 = input.int(82, 'MA 2', minval=1, maxval=9999, step=1, group='Strategy 5: MA CROSS')
MA2_type_5 = input.string('EMA', 'MA2 Type', options=['RMA', 'SMA', 'EMA', 'WMA', 'HMA', 'DEMA', 'TEMA', 'VWMA'], group='Strategy 5: MA CROSS')
MA2_source_5 = input.source(close, 'MA2 Source', group='Strategy 5: MA CROSS')
// * Inputs Potential TOP/BOTTOM
str_6 = input.bool(false, 'Close order at potential Top/Bottom', group='Potential TOP/BOTTOM')
top_qty = input.float(30, 'Top - take x (%) from the remaining position', minval=0.0, maxval=100, step=1, group='Potential TOP/BOTTOM')
bottom_qty = input.float(30, 'Bottom - take x (%) from the remaining position', minval=0.0, maxval=100, step=1, group='Potential TOP/BOTTOM')
source_6_top = input.source(close, 'TP-TOP at previous?', group='Potential TOP/BOTTOM')
source_6_bottom = input.source(close, 'TP-BOTTOM at previous?', group='Potential TOP/BOTTOM')
long_trail_perc = input.float(150, 'Trail volume Long (%)', minval=0.0, step=1, group='Potential TOP/BOTTOM') * 0.01
short_trail_perc = input.float(150, 'Trail volume Short (%)', minval=0.0, step=1, group='Potential TOP/BOTTOM') * 0.01
// * Flags
FLAG_SIGNALS = input.bool(true, 'Show Buy/Sell Signals ?', group='Miscellaneous')
FLAG_SHADOWS = input.bool(true, 'Show shadows satisfied strategies ?', group='Miscellaneous')
FLAG_FILLS = input.bool(true, 'Show simulated fills (entry / TP / close) ?', group='Miscellaneous')
// * Alarms
alarm_label_long = input.string('Buy', 'Label open long', group='Basic alarm system')
alarm_label_short = input.string('Sell', 'Label open short', group='Basic alarm system')
alarm_label_close_long = input.string('Close long', 'Label close long', group='Basic alarm system')
alarm_label_close_short = input.string('Close short', 'Label close short', group='Basic alarm system')
alarm_label_TP_long = input.string('TP long', 'Label Take Profit long', group='Basic alarm system')
alarm_label_TP_short = input.string('TP short', 'Label Take Profit short', group='Basic alarm system')
alarm_label_SL = input.string('SL', 'Label Stop-Loss', group='Basic alarm system')
// * Simulation (replaces the strategy() properties of the original script)
initial_capital = input.float(1000, 'Initial capital', minval=1, group='Simulation')
order_size_perc = input.float(100, 'Order size (% of equity)', minval=0.1, maxval=100, group='Simulation')
commission_perc = input.float(0.075, 'Commission (%)', minval=0, step=0.005, group='Simulation')
slippage_ticks = input.int(1, 'Slippage (ticks)', minval=0, group='Simulation')
comm_rate = commission_perc * 0.01
// *************************************************************************************************************************************************************************************************************************************************************************
// ABBREVIATIONS
// *************************************************************************************************************************************************************************************************************************************************************************
// TP: Take profits
// SL: Stop-Loss
// *************************************************************************************************************************************************************************************************************************************************************************
// POSITION SIMULATOR (replaces strategy.position_size, strategy.position_avg_price, strategy.opentrades, strategy.closedtrades, ...)
// *************************************************************************************************************************************************************************************************************************************************************************
type SimPos
    int   dir        = 0   // 1 long, -1 short, 0 flat
    float avg              // average entry price
    float qty        = 0.  // remaining units
    float init_qty   = 0.  // units at entry
    float entry_comm = 0.  // commission paid at entry
    int   entry_bar        // bar index of the entry
    int   exit_bar         // bar index of the last exit (partial or full)
    int   closed     = 0   // closed trades (each partial exit counts, as in strategy.closedtrades)
    int   wins       = 0
    float net        = 0.
    float gross_p    = 0.
    float gross_l    = 0.

// * Close q units at price (partial or full)
method reduce(SimPos s, float price, float q) =>
    float filled = 0.
    if s.dir != 0 and q > 0
        filled := math.min(q, s.qty)
        float pnl = s.dir * (price - s.avg) * filled - price * filled * comm_rate - s.entry_comm * filled / s.init_qty
        s.net := s.net + pnl
        if pnl > 0
            s.gross_p := s.gross_p + pnl
            s.wins := s.wins + 1
        else if pnl < 0
            s.gross_l := s.gross_l - pnl
        s.closed := s.closed + 1
        s.qty := s.qty - filled
        s.exit_bar := bar_index
        if s.qty <= s.init_qty * 1e-9
            s.dir := 0
            s.qty := 0.
            s.avg := na
            s.entry_bar := na
    filled

// * Open a position (reverses the current one if needed, like strategy.entry)
method enter(SimPos s, int d, float price) =>
    if s.dir != 0
        s.reduce(price, s.qty)
    float q = (initial_capital + s.net) * order_size_perc * 0.01 / price
    s.dir := d
    s.avg := price
    s.qty := q
    s.init_qty := q
    s.entry_comm := price * q * comm_rate
    s.entry_bar := bar_index
    q

var s = SimPos.new()
var tp_price = array.new_float(6, na)   // active TP limit orders
var tp_qty = array.new_float(6, 0.)
var float s6_limit = na                 // active Top/Bottom limit order
var float s6_qty = 0.
var int pend_entry = 0                  // market entry for next open: 1 / -1
var int pend_close = 0                  // market close for next open: 1 closes long, -1 closes short
// *************************************************************************************************************************************************************************************************************************************************************************
// GLOBAL VARIABLES
// *************************************************************************************************************************************************************************************************************************************************************************
start = timestamp(from_year, from_month, from_day, 00, 00) // backtest start window
end = timestamp(to_year, to_month, to_day, 23, 59)// backtest finish window
in_window = time >= start and time <= end
var price_stop_long = 0.
var price_stop_short = 0.
var profit_qty = 0. // Quantity to close per TP from open position
var profit_perc = 0. // Percentage to take profits since open position or last TP
var nextTP = 0. // Next target to take profits
var since_entry = 0 // Number of bars since open last postion
var since_close = 0 // Number of bars since close or TP/STOP last position
string alert_msg = ''

join(a, b) =>
    a == '' ? b : a + '\n' + b
// *************************************************************************************************************************************************************************************************************************************************************************
// ORDER FILLS (orders generated on the previous bar close)
// *************************************************************************************************************************************************************************************************************************************************************************
float slip = syminfo.mintick * slippage_ticks
bool ev_entry = false
bool ev_tp = false
bool ev_close = false
// * Market orders at open (entry first, like strategy.entry followed by strategy.close in the original)
if pend_entry != 0 and pend_entry != s.dir
    s.enter(pend_entry, open + pend_entry * slip)
    ev_entry := true
if pend_close != 0 and s.dir == pend_close
    s.reduce(open - pend_close * slip, s.qty)
    ev_close := true
pend_entry := 0
pend_close := 0
if ev_entry or s.dir == 0
    array.fill(tp_price, na)
    s6_limit := na
// * Limit orders intrabar (TP levels and Top/Bottom exit)
if s.dir != 0
    string tp_label = s.dir > 0 ? alarm_label_TP_long : alarm_label_TP_short
    for i = 0 to 5
        float lvl = array.get(tp_price, i)
        if not na(lvl) and s.dir != 0
            if (s.dir > 0 ? high >= lvl : low <= lvl)
                s.reduce(s.dir > 0 ? math.max(open, lvl) : math.min(open, lvl), array.get(tp_qty, i))
                array.set(tp_price, i, na)
                ev_tp := true
    if s.dir != 0 and not na(s6_limit)
        if (s.dir > 0 ? high >= s6_limit : low <= s6_limit)
            s.reduce(s.dir > 0 ? math.max(open, s6_limit) : math.min(open, s6_limit), s6_qty)
            s6_limit := na
            ev_tp := true
    if ev_tp
        alert_msg := join(alert_msg, tp_label)
    if s.dir == 0
        array.fill(tp_price, na)
        s6_limit := na

// * Compute profit quantity and profit percentage
if s.dir > 0
    profit_qty := long_profit_qty
    profit_perc := long_profit_perc
else if s.dir < 0
    profit_qty := short_profit_qty
    profit_perc := short_profit_perc
else
    nextTP := 0. // Next Take Profit target (out of market)
// *************************************************************************************************************************************************************************************************************************************************************************
// FUNCTIONS
// *************************************************************************************************************************************************************************************************************************************************************************
// * MA type
// *************************************************************************************************************************************************************************************************************************************************************************
ma(MAType, MASource, MAPeriod) =>
    if MAType == 'SMA'
        ta.sma(MASource, MAPeriod)
    else if MAType == 'EMA'
        ta.ema(MASource, MAPeriod)
    else if MAType == 'WMA'
        ta.wma(MASource, MAPeriod)
    else if MAType == 'RMA'
        ta.rma(MASource, MAPeriod)
    else if MAType == 'HMA'
        ta.wma(2 * ta.wma(MASource, math.floor(MAPeriod / 2)) - ta.wma(MASource, MAPeriod), math.round(math.sqrt(MAPeriod)))
    else if MAType == 'DEMA'
        e = ta.ema(MASource, MAPeriod)
        2 * e - ta.ema(e, MAPeriod)
    else if MAType == 'TEMA'
        e = ta.ema(MASource, MAPeriod)
        3 * (e - ta.ema(e, MAPeriod)) + ta.ema(ta.ema(e, MAPeriod), MAPeriod)
    else if MAType == 'VWMA'
        ta.vwma(MASource, MAPeriod)
// *************************************************************************************************************************************************************************************************************************************************************************
// * Price take profit
// *************************************************************************************************************************************************************************************************************************************************************************
price_takeProfit(percentage, N) =>
    s.dir > 0 ? s.avg * (1 + N * percentage) : s.avg * (1 - N * percentage)
// *************************************************************************************************************************************************************************************************************************************************************************
// * Weigthed values / total
// FIX: disabled strategies get weight 0 everywhere (the original only zeroed them inside the entry block, so plots/other conditions used the raw weights)
// *************************************************************************************************************************************************************************************************************************************************************************
w1 = str_1 ? weight_str1 : 0
w2 = str_2 ? weight_str2 : 0
w3 = str_3 ? weight_str3 : 0
w4 = str_4 ? weight_str4 : 0
w5 = str_5 ? weight_str5 : 0

weight_values(signal) =>
    signal ? 1.0 : 0.

weight_total(signal1, signal2, signal3, signal4, signal5) =>
    w1 * weight_values(signal1) + w2 * weight_values(signal2) + w3 * weight_values(signal3) + w4 * weight_values(signal4) + w5 * weight_values(signal5)
// *************************************************************************************************************************************************************************************************************************************************************************
// * Color
// FIX: switch compares against str.lower(type), so the cases must be lower-case ('TP'/'SL' never matched)
// *************************************************************************************************************************************************************************************************************************************************************************
colors(type, value=0) =>
    switch str.lower(type)
        'buy' => color.new(color.aqua, value)
        'sell' => color.new(color.gray, value)
        'tp' => color.new(color.aqua, value)
        'sl' => color.new(color.gray, value)
        'signal' => color.new(color.orange, value)
        'profit' => color.new(color.teal, value)
        'loss' => color.new(color.red, value)
        'info' => color.new(color.white, value)
        'highlights' => color.new(color.orange, value)
// *************************************************************************************************************************************************************************************************************************************************************************
// ADDITIONAL GLOBAL VARIABLES
// *************************************************************************************************************************************************************************************************************************************************************************
// * Compute time since last entry and last close/TP position
since_entry := s.dir != 0 ? bar_index - s.entry_bar : delay_exit
since_close := na(s.exit_bar) ? delay_exit : bar_index - s.exit_bar
// *************************************************************************************************************************************************************************************************************************************************************************
// STRATEGIES
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 1: MACD
// *************************************************************************************************************************************************************************************************************************************************************************
MA1 = ma(MA1_type_1, MA1_source_1, MA1_period_1)
MA2 = ma(MA2_type_1, MA2_source_1, MA2_period_1)

MACD = MA1 - MA2
signal = ma('SMA', MACD, 9)
hist = MACD - signal // FIX: was named 'trend' and got overwritten by the Supertrend, so the 'Trend' plot showed Supertrend values

long = MACD > signal
short = MACD < signal

// * Conditions
long_signal1 = long and long[delay_macd - 1] and not long[delay_macd]
short_signal1 = short and short[delay_macd - 1] and not short[delay_macd]
close_long1 = short and not long[delay_macd]
close_short1 = long and not short[delay_macd]
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 2: STOCH RSI
// *************************************************************************************************************************************************************************************************************************************************************************
rsi = ta.rsi(close, length_RSI)
srsi = ta.stoch(rsi, rsi, rsi, length_stoch)
k = ma('SMA', srsi, smoothK)
isRsiOB = k >= long_RSI
isRsiOS = k <= short_RSI

// * Conditions
long_signal2 = isRsiOS[delay_srsi] and not isRsiOB and since_entry >= delay_exit and since_close >= delay_exit
short_signal2 = isRsiOB[delay_srsi] and not isRsiOS and since_entry >= delay_exit and since_close >= delay_exit
close_long2 = short_signal2
close_short2 = long_signal2
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 3: RSI
// *************************************************************************************************************************************************************************************************************************************************************************
isRsiOB2 = rsi >= long_RSI2
isRsiOS2 = rsi <= short_RSI2

// * Conditions
long_signal3 = isRsiOS2[delay_rsi] and not isRsiOB2 and since_entry >= delay_exit and since_close >= delay_exit
short_signal3 = isRsiOB2[delay_rsi] and not isRsiOS2 and since_entry >= delay_exit and since_close >= delay_exit
close_long3 = short_signal3
close_short3 = long_signal3
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 4: SUPERTREND
// *************************************************************************************************************************************************************************************************************************************************************************
atr2 = ma('SMA', ta.tr, periods_4)
atr = change_ATR ? ta.atr(periods_4) : atr2
up = source_4 - multiplier * atr
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up

dn = source_4 + multiplier * atr
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

st_trend = 1
st_trend := nz(st_trend[1], st_trend)
st_trend := st_trend == -1 and close > dn1 ? 1 : st_trend == 1 and close < up1 ? -1 : st_trend

// * Conditions
long4 = st_trend == 1
short4 = st_trend == -1
long_signal4 = st_trend == 1 and st_trend[delay_super - 1] == 1 and st_trend[delay_super] == -1
short_signal4 = st_trend == -1 and st_trend[delay_super - 1] == -1 and st_trend[delay_super] == 1
close_long4 = short_signal4
close_short4 = long_signal4 // FIX: was short_signal4
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 5: MA CROSS
// *************************************************************************************************************************************************************************************************************************************************************************
MA12 = ma(MA1_type_5, MA1_source_5, MA1_period_5)
MA22 = ma(MA2_type_5, MA2_source_5, MA2_period_5)

long5 = MA12 > MA22
short5 = MA12 < MA22

// * Conditions
long_signal5 = long5 and long5[delay_cross - 1] and not long5[delay_cross]
short_signal5 = short5 and short5[delay_cross - 1] and not short5[delay_cross]
close_long5 = short5 and not long5[delay_cross]
close_short5 = long5 and not short5[delay_cross]
// *************************************************************************************************************************************************************************************************************************************************************************
// * STRATEGY 6: POTENTIAL TOP/BOTTOM
// *************************************************************************************************************************************************************************************************************************************************************************
// * Combination RSI, Stoch RSI, volume to detect potential TOP/BOTTOMS areas
vol_sma20 = ma('SMA', volume, 20)
volumeRSI_condition = volume[2] > volume[3] and volume[2] > volume[4] and volume[2] > volume[5]
condition_OB1 = isRsiOB2 and (isRsiOB or volume < vol_sma20 / 2) and volumeRSI_condition
condition_OS1 = isRsiOS2 and (isRsiOS or volume < vol_sma20 / 2) and volumeRSI_condition

condition_OB2 = volume[2] / volume[1] > (1.0 + long_trail_perc) and isRsiOB and volumeRSI_condition
condition_OS2 = volume[2] / volume[1] > (1.0 + short_trail_perc) and isRsiOS and volumeRSI_condition

condition_OB = (condition_OB1 or condition_OB2)
condition_OS = (condition_OS1 or condition_OS2)
condition_OB_several = condition_OB[1] and condition_OB[2] or condition_OB[1] and condition_OB[3] or condition_OB[1] and condition_OB[4] or condition_OB[1] and condition_OB[5] or condition_OB[1] and condition_OB[6] or condition_OB[1] and condition_OB[7]
condition_OS_several = condition_OS[1] and condition_OS[2] or condition_OS[1] and condition_OS[3] or condition_OS[1] and condition_OS[4] or condition_OS[1] and condition_OS[5] or condition_OS[1] and condition_OS[6] or condition_OS[1] and condition_OS[7]
// *************************************************************************************************************************************************************************************************************************************************************************
// * Weighted totals
// *************************************************************************************************************************************************************************************************************************************************************************
w_total_long = weight_total(long_signal1, long_signal2, long_signal3, long_signal4, long_signal5)
w_total_short = weight_total(short_signal1, short_signal2, short_signal3, short_signal4, short_signal5)
// *************************************************************************************************************************************************************************************************************************************************************************
// ENTRIES AND EXITS (orders are queued here and filled on the next bar)
// *************************************************************************************************************************************************************************************************************************************************************************
if in_window
    // ***************************************************************************************************************************************************************************
    // * Set Entries
    // ***************************************************************************************************************************************************************************
    bool go_short = false
    bool go_long = false
    if str_0
        go_short := allow_shorts and w_total_short >= weight_trigger
        go_long := allow_longs and w_total_long >= weight_trigger
    else
        go_short := allow_shorts and ((str_1 and short_signal1) or (str_2 and short_signal2) or (str_3 and short_signal3) or (str_4 and short_signal4) or (str_5 and short_signal5))
        go_long := allow_longs and ((str_1 and long_signal1) or (str_2 and long_signal2) or (str_3 and long_signal3) or (str_4 and long_signal4) or (str_5 and long_signal5))
    if go_short
        pend_entry := -1
    if go_long // the original also calls the Long entry after the Short one, so Long wins when both fire on the same bar
        pend_entry := 1
    if pend_entry == s.dir // already in that direction: ignored (pyramiding = 0)
        pend_entry := 0
    if pend_entry != 0
        alert_msg := join(alert_msg, pend_entry > 0 ? alarm_label_long : alarm_label_short)
    // ***************************************************************************************************************************************************************************
    // * Set Take Profits
    // ***************************************************************************************************************************************************************************
    if s.dir != 0 and take_profits and since_entry == 0
        for i = 1 to MAX_TP
            array.set(tp_price, i - 1, price_takeProfit(profit_perc, i))
            array.set(tp_qty, i - 1, s.init_qty * profit_qty * 0.01)
    // ***************************************************************************************************************************************************************************
    // * Set Stop loss (same ladder as the original, written as a loop)
    // ***************************************************************************************************************************************************************************
    if s.dir != 0
        if since_close == 0
            int hit = 0
            for j = 0 to 5
                int n = 6 - j
                if hit == 0 and MAX_TP >= n
                    float lvl = price_takeProfit(profit_perc, n)
                    if (s.dir > 0 ? high > lvl : low < lvl)
                        hit := n
            if hit > 0
                nextTP := hit == 6 ? na : price_takeProfit(profit_perc, hit + 1)
                float new_stop = na
                if movestoploss == 'Percentage'
                    new_stop := s.avg * (1 + s.dir * (hit * profit_perc - stoploss_perc * move_stoploss_factor))
                else if movestoploss != 'None'
                    int kk = movestoploss == 'TP-1' ? 1 : movestoploss == 'TP-2' ? 2 : 3
                    if hit - kk >= 1
                        new_stop := price_takeProfit(profit_perc, hit - kk)
                    else if movestoploss_entry
                        new_stop := s.avg
                if not na(new_stop)
                    if s.dir > 0
                        price_stop_long := new_stop
                    else
                        price_stop_short := new_stop
        if since_entry == 0
            nextTP := price_takeProfit(profit_perc, 1)
            if s.dir > 0
                price_stop_long := s.avg * (1 - stoploss_perc)
            else
                price_stop_short := s.avg * (1 + stoploss_perc)
    // ***************************************************************************************************************************************************************************
    // * Set Exits
    // ***************************************************************************************************************************************************************************
    string close_label = ''
    if allow_longs and not allow_shorts and s.dir > 0
        bool c = str_0 ? w_total_short >= weight_trigger : ((str_1 and close_long1) or (str_2 and close_long2) or (str_3 and close_long3) or (str_4 and close_long4) or (str_5 and close_long5))
        if c
            pend_close := 1
            close_label := alarm_label_close_long
    if not allow_longs and allow_shorts and s.dir < 0
        // FIX: the original closed Shorts with the close_long* conditions
        bool c = str_0 ? w_total_long >= weight_trigger : ((str_1 and close_short1) or (str_2 and close_short2) or (str_3 and close_short3) or (str_4 and close_short4) or (str_5 and close_short5))
        if c
            pend_close := -1
            close_label := alarm_label_close_short
    if allow_shorts and s.dir < 0 and stoploss and since_entry > 0 and stop_source >= price_stop_short
        pend_close := -1
        close_label := alarm_label_SL
    if allow_longs and s.dir > 0 and stoploss and since_entry > 0 and stop_source <= price_stop_long
        pend_close := 1
        close_label := alarm_label_SL
    // FIX: Top/Bottom exits no longer depend on the 'Stop loss' switch, and the Short side checks bottom_qty (it checked top_qty)
    if str_6 and allow_shorts and s.dir < 0 and since_entry > 0 and condition_OS_several
        if bottom_qty == 100
            pend_close := -1
            close_label := alarm_label_SL
        else
            s6_limit := source_6_bottom[1]
            s6_qty := s.qty * bottom_qty * 0.01
    if str_6 and allow_longs and s.dir > 0 and since_entry > 0 and condition_OB_several
        if top_qty == 100
            pend_close := 1
            close_label := alarm_label_SL
        else
            s6_limit := source_6_top[1]
            s6_qty := s.qty * top_qty * 0.01
    if pend_close != 0 and pend_entry == 0 // a pending reversal already closes the position
        alert_msg := join(alert_msg, close_label)
// * Alerts: one message per bar, sent at bar close (create the alert with "Any alert() function call")
if alert_msg != ''
    alert(alert_msg, alert.freq_once_per_bar_close)
alertcondition(w_total_long >= weight_trigger, 'Buy (weighted)', 'Buy')
alertcondition(w_total_short >= weight_trigger, 'Sell (weighted)', 'Sell')
// *************************************************************************************************************************************************************************************************************************************************************************
// * Data window - debugging
// *************************************************************************************************************************************************************************************************************************************************************************
price_stop = s.dir > 0 ? price_stop_long : price_stop_short
open_profit = s.dir != 0 ? s.dir * (close - s.avg) * s.qty : 0.
sim_equity = initial_capital + s.net + open_profit
winrate = s.closed > 0 ? s.wins * 100.0 / s.closed : na

plotchar(volume[2] / volume[1], "Volume 2 / Volume 1", "", location.top, size = size.tiny, color=color.new(color.orange, 0))
plotchar(since_entry, "Since entry [bars]", "", location.top, size = size.tiny, color=color.new(color.orange, 0))
plotchar(since_close, "Since close/TP [bars]", "", location.top, size = size.tiny, color=color.new(color.orange, 0))
plotchar(s.avg, "Average position price", "", location.top, size = size.tiny, color=color.new(color.orange, 0))
plotchar(s.dir * s.qty, "Position size", "", location.top, size = size.tiny, color=color.new(color.orange, 0))
plotchar(nextTP, "Next TP target", "", location.top, size = size.tiny, color=color.new(color.teal, 0))
plotchar(price_stop, "STOP Price", "", location.top, size = size.tiny, color=color.new(color.gray, 0))
plotchar(s.dir != 0 ? 1 : 0, "Open trades", "", location.top, size = size.tiny, color=s.dir > 0 ? color.blue : color.gray)
plotchar(s.net, "Net profit [$]", "", location.top, size = size.tiny, color=s.net > 0 ? color.blue : color.gray)
plotchar(s.gross_p, "Gross profit [$]", "", location.top, size = size.tiny, color=color.blue)
plotchar(s.gross_l, "Gross loss [$]", "", location.top, size = size.tiny, color=color.gray)
plotchar(open_profit, "Unrealized P&L [$]", "", location.top, size = size.tiny, color=open_profit > 0 ? color.blue : color.gray)
plotchar(s.closed, "Closed trades", "", location.top, size = size.tiny, color=color.orange)
plotchar(winrate, "Winrate [%]", "", location.top, size = size.tiny, color=winrate > 60 ? color.blue : color.gray) // FIX: compared a 0-1 ratio with 60
plotchar(sim_equity, "Equity [$]", "", location.top, size = size.tiny, color=color.orange)
// *************************************************************************************************************************************************************************************************************************************************************************
