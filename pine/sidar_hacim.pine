//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  Sidar Hacim
//  Sidar Demirgil'in hacim kurallarını alt panelde görselleştirir.
//  TradingView'in standart "Volume" göstergesinin yerine kullanılır.
//
//  Repaint politikası
//  • Tüm sinyal ve etiketler yalnızca kapanmış mumda (barstate.isconfirmed) oluşur.
//  • Pivotlar "sağ bar" sayısı kadar gecikmeyle onaylanır; dalga ve seviye
//    etiketleri bu yüzden birkaç mum geç gelir.
//  • request.security_lower_tf ileriye bakmaz (lookahead parametresi yoktur).
//  • Ana grafiğe etiket basılmaz; zon kırılımlarının hacmi "Sidar PA Asistanı"nda (H+ / H−) gösterilir.
// ════════════════════════════════════════════════════════════════════════════
indicator("Sidar Hacim", shorttitle = "Sidar Hacim", overlay = false, format = format.volume,
     max_labels_count = 40, max_boxes_count = 50, max_bars_back = 500)

// ════════════════════════════════════════════════════════════════════════════
//  AYARLAR
// ════════════════════════════════════════════════════════════════════════════
G1 = "1 · Hacim çubukları ve RVOL"
i_b1     = input.bool(true, "Bölüm 1'i göster", group = G1)
i_n      = input.int(20, "Ortalama hacim periyodu (N)", minval = 2, group = G1)
i_e1     = input.float(1.5, "Yüksek hacim eşiği (RVOL)", minval = 0.1, step = 0.1, group = G1)
i_e2     = input.float(2.0, "Çok yüksek hacim eşiği (RVOL)", minval = 0.1, step = 0.1, group = G1)
i_ortCiz = input.bool(true, "Ortalama hacim çizgisi", group = G1)
i_tablo  = input.bool(true, "RVOL tablosu", group = G1)

G2 = "2 · Pivotlar ve dalga hacmi"
i_b2     = input.bool(true, "Bölüm 2'yi aç", group = G2)
i_pvL    = input.int(5, "Pivot sol bar", minval = 1, maxval = 50, group = G2)
i_pvR    = input.int(5, "Pivot sağ bar (onay gecikmesi)", minval = 1, maxval = 50, group = G2)
i_sahte  = input.bool(false, "'Sahte satış? / sahte alış?' noktaları", group = G2,
     tooltip = "Yükselişte ortalamanın altında hacimli satıcılı mumlar, düşüşte ortalamanın altında hacimli alıcılı mumlar.")

G3 = "3 · Kuruyan hacim ve kırılım"
i_b3      = input.bool(true, "Bölüm 3'ü aç", group = G3)
i_kirBekle = input.int(10, "Aynı yönde iki kırılım işareti arası en az (bar)", minval = 1, group = G3)
i_svMes   = input.float(0.5, "Seviye kümeleme mesafesi (× ATR14)", minval = 0.1, step = 0.1, group = G3)
i_svMin   = input.int(2, "Seviye için minimum pivot", minval = 2, maxval = 10, group = G3)
i_kuruN   = input.int(6, "Kuruyan hacim: bakılacak mum", minval = 5, maxval = 10, group = G3)
i_yakin   = input.float(1.5, "Seviyeye 'yaklaşıyor' mesafesi (× ATR14)", minval = 0.1, step = 0.1, group = G3)

G4 = "4 · Tükeniş"
i_b4       = input.bool(true, "Bölüm 4'ü aç", group = G4)
i_govdeKat = input.float(2.0, "Gövde ≥ ortalama gövde ×", minval = 1.0, step = 0.1, group = G4)
i_tukRvol  = input.float(2.0, "Minimum RVOL", minval = 1.0, step = 0.1, group = G4)
i_benzer   = input.float(0.8, "Satıcı/alıcı tükendi: benzerlik oranı", minval = 0.5, maxval = 1.0, step = 0.05, group = G4)

G5 = "5 · Sessizlik sonrası ilk hacim"
i_b5       = input.bool(true, "Bölüm 5'i aç", group = G5)
i_sesN     = input.int(20, "Sessizlik için bakılacak mum (N)", minval = 5, group = G5)
i_sesYuzde = input.int(20, "Sessiz mum: hacmi en düşük % dilimde", minval = 5, maxval = 50, group = G5)
i_sesBar   = input.int(5, "Sessiz bölgeden sonra en fazla mum", minval = 1, maxval = 20, group = G5)
i_sesRvol  = input.float(1.5, "Minimum RVOL", minval = 1.0, step = 0.1, group = G5)

G6 = "6 · Mum içi alış/satış tahmini"
i_b6       = input.bool(false, "Bölüm 6'yı aç (tahmin)", group = G6)
i_altOto   = input.bool(true, "Alt zaman dilimi otomatik (≈ grafik / 5)", group = G6)
i_altZd    = input.timeframe("1", "Alt zaman dilimi (otomatik kapalıyken)", group = G6)
i_deltaYer = input.string("Panelde seri", "Delta gösterimi", options = ["Panelde seri", "Tabloda"], group = G6)


// ─── Renkler ────────────────────────────────────────────────────────────────
color cAcikGri     = #b2b5be
color cKoyuGri     = #5d606b
color cAcikYesil   = #a5d6a7
color cKoyuYesil   = #2e7d32
color cAcikKirmizi = #ef9a9a
color cKoyuKirmizi = #c62828
color cOrt         = #ff9800
color cBilgi       = #7e57c2

// ════════════════════════════════════════════════════════════════════════════
//  ORTAK HESAPLAR
// ════════════════════════════════════════════════════════════════════════════
cf       = barstate.isconfirmed
vol      = nz(volume)
atr14    = ta.atr(14)
govde    = math.abs(close - open)
ortGovde = ta.sma(govde, 20)[1]          // son 20 mumun (bu mum hariç) ortalama gövdesi
ortHacim = ta.sma(vol, i_n)
ortOnce  = ortHacim[1]                   // RVOL paydası: bu mum hariç son N mum
rvol     = ortOnce > 0 ? vol / ortOnce : na
yukselisMumu = close > open
dususMumu    = close < open

var bool hacimVar = false
if not na(volume) and volume > 0
    hacimVar := true

// Etiket sınırı kod içinde uygulanır
var array<label> panelEt = array.new<label>()
f_sakla(array<label> dizi, label lb, int limit) =>
    array.push(dizi, lb)
    while array.size(dizi) > limit
        label.delete(array.shift(dizi))
    true

// Panelde, hacim çubuğunun üstüne kısa etiket; tam açıklama tooltip'te. En fazla 20 etiket.
f_panel(string yazi, string aciklama, color renk) =>
    f_sakla(panelEt, label.new(bar_index, vol, yazi, yloc = yloc.price, style = label.style_label_down,
         color = color.new(renk, 15), textcolor = color.white, size = size.tiny, tooltip = aciklama), 20)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 1 · HACİM ÇUBUKLARI VE RVOL
// ════════════════════════════════════════════════════════════════════════════
color hacimRenk = na(rvol) or rvol < i_e1 ? (yukselisMumu ? cAcikGri : cKoyuGri) :
     rvol < i_e2 ? (yukselisMumu ? cAcikYesil : cAcikKirmizi) : (yukselisMumu ? cKoyuYesil : cKoyuKirmizi)

plot(i_b1 ? volume : na, "Hacim", color = hacimRenk, style = plot.style_columns)
// Çizgi = RVOL paydası (önceki N mum ortalaması); çubuk bu çizginin 1,5 / 2 katını geçince renk değişir
plot(i_b1 and i_ortCiz ? ortOnce : na, "Ortalama hacim", color = cOrt, linewidth = 1)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 2 · PİVOTLAR VE DALGA HACMİ
// ════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, i_pvL, i_pvR)
pl = ta.pivotlow(low, i_pvL, i_pvR)

var float sonH  = na
var float sonL  = na
var int   hTip  = 0      // 1 yükselen tepe, -1 alçalan tepe
var int   lTip  = 0      // 1 yükselen dip, -1 alçalan dip
var int   trend = 0      // 1 yükseliş, -1 düşüş, 0 belirsiz

// Zigzag (dalgalar pivotlar arasında tanımlanır)
var int   zzTip     = 0
var int   zzBar     = na
var float zzFiyat   = na
var int   dalgaBas  = na     // son dalganın başladığı pivot barı
var float itisOrt   = na     // son itiş dalgasının ortalama hacmi
var int   itisYon   = 0
var box   sonKutu   = na     // son geri çekilme boyası
var label sonKutuEt = na
var int   sonKutuBas = na
var array<box> dalgaKutu = array.new<box>()

// Dalganın (bas..son barları) ortalama ve en yüksek hacmi
f_dalga(int bas, int son) =>
    int   o1  = bar_index - son
    int   o2  = math.min(bar_index - bas, o1 + 300)
    float top = 0.0
    float mx  = 0.0
    int   n   = 0
    for o = o1 to o2
        float v = nz(volume[o])
        top += v
        mx  := math.max(mx, v)
        n   += 1
    [n > 0 ? top / n : na, mx]

if cf
    for k = 0 to 1
        int   tip   = k == 0 ? 1 : -1
        float fiyat = k == 0 ? ph : pl
        if not na(fiyat)
            int pBar = bar_index - i_pvR
            // Trend: yükselen tepe + yükselen dip / alçalan tepe + alçalan dip
            if tip == 1
                hTip := na(sonH) ? 0 : fiyat > sonH ? 1 : -1
                sonH := fiyat
            else
                lTip := na(sonL) ? 0 : fiyat > sonL ? 1 : -1
                sonL := fiyat
            if hTip == 1 and lTip == 1
                trend := 1
            else if hTip == -1 and lTip == -1
                trend := -1
            // Zigzag: ters tipte pivot yeni dalga, aynı tipte daha uç pivot dalgayı uzatır
            bool yeniDalga = zzTip == -tip
            bool uzat      = zzTip == tip and (tip == 1 ? fiyat > zzFiyat : fiyat < zzFiyat)
            if yeniDalga
                dalgaBas := zzBar
            if yeniDalga or uzat or zzTip == 0
                zzTip   := tip
                zzBar   := pBar
                zzFiyat := fiyat
            if (yeniDalga or uzat) and not na(dalgaBas) and pBar > dalgaBas
                [ort, mx] = f_dalga(dalgaBas, pBar)
                int dYon = tip    // tepede biten dalga yukarı, dipte biten aşağı
                if trend != 0 and dYon == trend
                    // Trend yönündeki itiş dalgası
                    itisOrt := ort
                    itisYon := trend
                else if i_b2 and trend != 0 and dYon == -trend and itisYon == trend and not na(itisOrt)
                    // Geri çekilme dalgası: itişle karşılaştır
                    if uzat and sonKutuBas == dalgaBas
                        box.delete(sonKutu)
                        label.delete(sonKutuEt)
                    bool saglikli = ort < itisOrt
                    color ton = saglikli ? cKoyuYesil : cKoyuKirmizi
                    sonKutu := box.new(dalgaBas, mx, pBar, 0, border_color = color.new(ton, 100), bgcolor = color.new(ton, 85))
                    array.push(dalgaKutu, sonKutu)
                    while array.size(dalgaKutu) > 40
                        box.delete(array.shift(dalgaKutu))
                    sonKutuBas := dalgaBas
                    sonKutuEt  := label.new(pBar, mx, saglikli ? "S✓" : "K!", yloc = yloc.price,
                         style = label.style_label_down, color = color.new(ton, 20), textcolor = color.white, size = size.tiny,
                         tooltip = saglikli ? "Sağlıklı: geri çekilme hacmi itiş dalgasından düşük" : "Karşı taraf güçlü: geri çekilme hacmi itiş dalgasından yüksek")
                    f_sakla(panelEt, sonKutuEt, 20)

// Opsiyonel: sahte satış / sahte alış noktaları
sahteSatis = i_b2 and i_sahte and cf and trend == 1 and dususMumu and vol < ortOnce
sahteAlis  = i_b2 and i_sahte and cf and trend == -1 and yukselisMumu and vol < ortOnce
plotshape(sahteSatis ? vol : na, "Sahte satış?", shape.circle, location.absolute, color.orange, size = size.tiny)
plotshape(sahteAlis ? vol : na, "Sahte alış?", shape.circle, location.absolute, color.aqua, size = size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 3 · KURUYAN HACİM VE KIRILIM
// ════════════════════════════════════════════════════════════════════════════
var array<float> svFiyat = array.new<float>()
var array<int>   svSay   = array.new<int>()
var array<int>   svSon   = array.new<int>()   // son güncellenme barı
var array<int>   svKir   = array.new<int>()   // son kırılım barı

// Pivotu yakın seviyeye ekle ya da yeni seviye aç (tepe ve dip ayrı ayrı)
if cf and i_b3
    float mesafe = atr14 * i_svMes
    for k = 0 to 1
        float pf = k == 0 ? ph : pl
        if not na(pf)
            int   enIyi = -1
            float enAz  = mesafe
            int   n     = array.size(svFiyat)
            if n > 0
                for i = 0 to n - 1
                    float d = math.abs(array.get(svFiyat, i) - pf)
                    if d <= enAz
                        enAz  := d
                        enIyi := i
            if enIyi >= 0
                int c = array.get(svSay, enIyi)
                array.set(svFiyat, enIyi, (array.get(svFiyat, enIyi) * c + pf) / (c + 1))
                array.set(svSay, enIyi, c + 1)
                array.set(svSon, enIyi, bar_index)
            else
                array.push(svFiyat, pf)
                array.push(svSay, 1)
                array.push(svSon, bar_index)
                array.push(svKir, 0)
                if array.size(svFiyat) > 60
                    int eski = 0
                    for i = 1 to array.size(svSon) - 1
                        if array.get(svSon, i) < array.get(svSon, eski)
                            eski := i
                    array.remove(svFiyat, eski)
                    array.remove(svSay, eski)
                    array.remove(svSon, eski)
                    array.remove(svKir, eski)

// En yakın kümelenmiş seviyeye mesafe (yalnızca "kuruyan hacim" için)
float yakinMes = na
if i_b3 and array.size(svFiyat) > 0
    for i = 0 to array.size(svFiyat) - 1
        if array.get(svSay, i) >= i_svMin
            float d = math.abs(close - array.get(svFiyat, i))
            yakinMes := na(yakinMes) ? d : math.min(yakinMes, d)

// Kuruyan hacim: seviyeye yaklaşırken kısa hacim ortalaması düşüyor
kOrt   = ta.sma(vol, 3)
yariN  = int(math.floor(i_kuruN / 2))
yaklasiyor    = not na(yakinMes) and yakinMes <= i_yakin * atr14 and yakinMes < nz(yakinMes[i_kuruN], 1e20)
hacimAzaliyor = kOrt < kOrt[yariN] and kOrt[yariN] < kOrt[i_kuruN] and kOrt < ortOnce
kuruyan = i_b3 and cf and yaklasiyor and hacimAzaliyor
// Panelin altında ince, mor, yarı saydam şerit (yazı yok)
plotshape(kuruyan, "Kuruyan hacim", shape.square, location.bottom, color.new(cBilgi, 50), size = size.tiny)

// Kırılım: yalnızca son pivot tepe / dibin (piyasa yapısı seviyesi) KAPANIŞLA kırılması
var int sonKirL = na
var int sonKirS = na
kirYukari = not na(sonH) and close > sonH and close[1] <= sonH
kirAsagi  = not na(sonL) and close < sonL and close[1] >= sonL
bekleL = not na(sonKirL) and bar_index - sonKirL < i_kirBekle
bekleS = not na(sonKirS) and bar_index - sonKirS < i_kirBekle
bool kirHacimliYuk  = i_b3 and cf and kirYukari and not bekleL and rvol >= 2
bool kirHacimsizYuk = i_b3 and cf and kirYukari and not bekleL and rvol < 1
bool kirHacimliAsg  = i_b3 and cf and kirAsagi and not bekleS and rvol >= 2
bool kirHacimsizAsg = i_b3 and cf and kirAsagi and not bekleS and rvol < 1
if kirHacimliYuk or kirHacimsizYuk
    sonKirL := bar_index
if kirHacimliAsg or kirHacimsizAsg
    sonKirS := bar_index
bool hacimliKir  = kirHacimliYuk or kirHacimliAsg
bool hacimsizKir = kirHacimsizYuk or kirHacimsizAsg
plotshape(kirHacimliYuk ? vol : na, "Hacimli kırılım (yukarı)", shape.triangleup, location.absolute, cKoyuYesil, text = "K+", textcolor = cKoyuYesil, size = size.tiny)
plotshape(kirHacimliAsg ? vol : na, "Hacimli kırılım (aşağı)", shape.triangledown, location.absolute, cKoyuYesil, text = "K+", textcolor = cKoyuYesil, size = size.tiny)
plotshape(kirHacimsizYuk ? vol : na, "Hacimsiz kırılım (yukarı)", shape.triangleup, location.absolute, color.orange, text = "K−", textcolor = color.orange, size = size.tiny)
plotshape(kirHacimsizAsg ? vol : na, "Hacimsiz kırılım (aşağı)", shape.triangledown, location.absolute, color.orange, text = "K−", textcolor = color.orange, size = size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 4 · TÜKENİŞ (bilgi etiketi, giriş sinyali değil)
// ════════════════════════════════════════════════════════════════════════════
buyukMum = govde >= i_govdeKat * ortGovde and rvol >= i_tukRvol
tukenis  = i_b4 and cf and buyukMum and ((trend == 1 and dususMumu) or (trend == -1 and yukselisMumu))

// Dev hacimli satış mumunu benzer boy ve hacimde alıcı mum yutuyor (ve tersi)
devSatis = dususMumu[1] and rvol[1] >= i_tukRvol
devAlis  = yukselisMumu[1] and rvol[1] >= i_tukRvol
yutarYukari = yukselisMumu and close >= open[1] and open <= close[1]
yutarAsagi  = dususMumu and close <= open[1] and open >= close[1]
benzer = govde >= i_benzer * govde[1] and vol >= i_benzer * vol[1]
saticiTukendi = i_b4 and cf and devSatis and yutarYukari and benzer
aliciTukendi  = i_b4 and cf and devAlis and yutarAsagi and benzer

if tukenis
    f_panel("T?", "Tükeniş? Trendin tersine dev gövdeli ve yüksek hacimli mum. Bilgi etiketidir; kurala göre hemen girilmez, ilk geri çekilme beklenir.", color.purple)
if saticiTukendi
    f_panel("ST", "Satıcı tükendi: dev hacimli satış mumu benzer boy ve hacimde alıcı mumla yutuldu", cKoyuYesil)
if aliciTukendi
    f_panel("AT", "Alıcı tükendi: dev hacimli alış mumu benzer boy ve hacimde satıcı mumla yutuldu", cKoyuKirmizi)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 5 · SESSİZLİK SONRASI İLK HACİM
// ════════════════════════════════════════════════════════════════════════════
sessizEsik = ta.percentile_nearest_rank(vol, i_sesN, i_sesYuzde)
var int sonSessiz = na
bool sessizAlici = false
bool sessizSatici = false
if cf and i_b5
    int fark = na(sonSessiz) ? 999 : bar_index - sonSessiz
    if fark >= 1 and fark <= i_sesBar and rvol >= i_sesRvol
        if trend == 1 and yukselisMumu
            sessizAlici := true
        else if trend == -1 and dususMumu
            sessizSatici := true
        if sessizAlici or sessizSatici
            sonSessiz := na     // yalnızca ilk hacimli mum
    if vol > 0 and vol <= sessizEsik
        sonSessiz := bar_index
if sessizAlici
    f_panel("SS↑", "Sessizlik sonrası alıcı: düşük hacimli bölgeden sonra trend yönünde ilk hacimli mum", cKoyuYesil)
if sessizSatici
    f_panel("SS↓", "Sessizlik sonrası satıcı: düşük hacimli bölgeden sonra trend yönünde ilk hacimli mum", cKoyuKirmizi)

// ════════════════════════════════════════════════════════════════════════════
//  BÖLÜM 6 · MUM İÇİ ALIŞ/SATIŞ TAHMİNİ (gerçek order flow değildir)
// ════════════════════════════════════════════════════════════════════════════
f_altOto() =>
    int s = timeframe.in_seconds()
    timeframe.from_seconds(math.max(60, int(s / 5)))
altZd = i_altOto ? f_altOto() : i_altZd
// Alt mum kapanışı açılışının üstündeyse hacmi alış (+), altındaysa satış (−)
array<float> altDelta = request.security_lower_tf(syminfo.tickerid, altZd, close > open ? nz(volume) : close < open ? -nz(volume) : 0.0, ignore_invalid_timeframe = true)
float delta = i_b6 and array.size(altDelta) > 0 ? array.sum(altDelta) : na
plot(i_b6 and i_deltaYer == "Panelde seri" ? math.abs(delta) : na, "Delta (tahmin)",
     color = delta >= 0 ? cKoyuYesil : cKoyuKirmizi, style = plot.style_circles, linewidth = 2)

// ════════════════════════════════════════════════════════════════════════════
//  TABLO
// ════════════════════════════════════════════════════════════════════════════
rvolSon  = cf ? rvol : rvol[1]      // son KAPANAN mumun RVOL'u
deltaSon = cf ? delta : delta[1]
var table tbl = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 25), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.clear(tbl, 0, 0, 1, 2)
    if not hacimVar
        table.cell(tbl, 0, 0, "Bu enstrümanda hacim verisi yok", text_color = color.orange, text_size = size.small)
    else if i_tablo
        string durum = na(rvolSon) ? "-" : rvolSon < i_e1 ? "Normal" : rvolSon < i_e2 ? "Yüksek" : "Çok yüksek"
        color durumRenk = na(rvolSon) or rvolSon < i_e1 ? cKoyuGri : rvolSon < i_e2 ? cAcikYesil : cKoyuYesil
        table.cell(tbl, 0, 0, "RVOL", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 0, na(rvolSon) ? "-" : str.tostring(rvolSon, "0.00"), text_color = color.white, text_size = size.small)
        table.cell(tbl, 0, 1, "Durum", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 1, durum, text_color = color.white, bgcolor = color.new(durumRenk, 30), text_size = size.small)
        if i_b6 and i_deltaYer == "Tabloda"
            table.cell(tbl, 0, 2, "Delta (tahmin)", text_color = color.white, text_size = size.small)
            table.cell(tbl, 1, 2, na(deltaSon) ? "-" : str.tostring(deltaSon, format.volume), text_color = color.white,
                 bgcolor = color.new(nz(deltaSon) >= 0 ? cKoyuYesil : cKoyuKirmizi, 40), text_size = size.small)

// ════════════════════════════════════════════════════════════════════════════
//  ALARMLAR
// ════════════════════════════════════════════════════════════════════════════
alertcondition(hacimliKir, "Hacimli kırılım", "Sidar Hacim: hacimli kırılım – {{ticker}} {{interval}}")
alertcondition(hacimsizKir, "Hacimsiz kırılım", "Sidar Hacim: hacimsiz kırılım, tuzak riski – {{ticker}} {{interval}}")
alertcondition(tukenis, "Tükeniş", "Sidar Hacim: tükeniş? – {{ticker}} {{interval}}")
alertcondition(saticiTukendi or aliciTukendi, "Satıcı / alıcı tükendi", "Sidar Hacim: satıcı ya da alıcı tükendi – {{ticker}} {{interval}}")
alertcondition(sessizAlici or sessizSatici, "Sessizlik sonrası ilk hacim", "Sidar Hacim: sessizlik sonrası ilk hacim – {{ticker}} {{interval}}")
